{
  "name": "tavily-lb-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p e2e && tsc -p e2e-live",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:full": "pnpm build && cargo build --release --manifest-path ../Cargo.toml && playwright test",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.5",
    "@astryxdesign/theme-neutral": "^0.6.5",
    "@stylexjs/stylex": "^0.19.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
